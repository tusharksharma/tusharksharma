{
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "echo 'skip: dist/ is committed'",
  "installCommand": "echo 'skip: no deps to install'",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    { "source": "/shop", "destination": "/favorites", "permanent": true }
  ],
  "rewrites": [
    { "source": "/videos/:recipe/:filename(.+\\.mp4)", "destination": "https://github.com/tusharma88/tsp-videos/releases/download/videos/:filename" },
    { "source": "/videos/:recipe/:filename(.+\\.m4a)", "destination": "https://github.com/tusharma88/tsp-videos/releases/download/videos/:filename" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ]
}
