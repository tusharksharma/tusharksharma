# ---------- YouTube (Google Cloud Console) ----------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Leave blank. Filled in automatically the first time you run: npm run setup:youtube
YT_REFRESH_TOKEN=

# ---------- Instagram (Meta for Developers) ----------
# Generated in the Meta App Dashboard under Instagram > API setup with Instagram login
IG_ACCESS_TOKEN=
IG_USER_ID=

# ---------- TikTok (TikTok for Developers) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Leave blank. Filled in automatically the first time you run: npm run setup:tiktok
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

PORT=3000
